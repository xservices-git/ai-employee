# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Database
DATABASE_URL=sqlite:///./data/ai-employee.db

# Vector store
CHROMA_PATH=./data/chroma

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_CLASSIFIER=qwen2.5:4b
OLLAMA_MODEL_PLANNER=llama3.1:8b
OLLAMA_MODEL_EXECUTOR=qwen2.5:4b
OLLAMA_MODEL_CRITIC=llama3.1:8b
OLLAMA_MODEL_CURATOR=qwen2.5:4b
OLLAMA_MODEL_EMBED=nomic-embed-text:v1.5
OLLAMA_MODEL_RERANK=bge-reranker-base

# MCP servers
MCP_DATA_PROCESSING_URL=stdio://./mcp-servers/data-processing/server.py
MCP_COMMUNICATION_URL=stdio://./mcp-servers/communication/server.py

# Communication (for communication MCP server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Web research
WEB_SEARCH_PROVIDER=duckduckgo
WEB_FETCH_TIMEOUT=30

# Rate limiting
RATE_LIMIT_PER_USER_HOUR=100
RATE_LIMIT_PER_TOOL_HOUR=1000
RATE_LIMIT_GLOBAL_HOUR=10000

# Confidence thresholds (defaults, override per domain)
CONFIDENCE_AUTO_EXECUTE=0.70
CONFIDENCE_APPROVAL_REQUIRED=0.40

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090

# Workspace
WORKSPACE_DIR=./workspace
